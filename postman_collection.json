              "raw": "{{base_url}}/api/courses",
              "host": ["{{base_url}}"],
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "Get Single Course",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/courses/:courseId",
              "host": ["{{base_url}}"],
              "path": ["api", "courses", ":courseId"]
            }
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
