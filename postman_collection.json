            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lesson Title\",\n  \"description\": \"Lesson description\",\n  \"videoUrl\": \"https://example.com/video.mp4\",\n  \"duration\": 45,\n  \"order\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
