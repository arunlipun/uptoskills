            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Course\",\n  \"description\": \"Course description here\",\n  \"category\": \"Web Development\",\n  \"level\": \"beginner\",\n  \"price\": 99.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/courses",
              "host": ["{{base_url}}"],
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
