            "url": {
              "raw": "{{base_url}}/api/courses/:courseId",
              "host": ["{{base_url}}"],
              "path": ["api", "courses", ":courseId"]
            }
          }
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
